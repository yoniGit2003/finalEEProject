{
 "name": "WAA equation of Part 1 (closed form adopted in S8b)",
 "form": {
  "A": "A(t) - c = W_f(t) + W_s(t) + L c_band R(t - d)",
  "W_f": "dW_f/dt = (phi u - W_f) / tau_f, tau_f = tau_f_wet while W_f rises (phi u > W_f), tau_f_dry while it falls",
  "W_s": "dW_s/dt = ((1 - phi) u - W_s) / tau_s",
  "u": "u = a_link A_band (R(t - d) / 5)^b",
  "update": "once per minute: W <- target + (W - target) exp(-1 / tau); the output after the update"
 },
 "rain_input": "R = radar path-mean rain (release radar_along_links_5min R_mean, held over its 5 minutes) / g_e; g_e = radar / City-gauge rain of the event over its gauge links (City gauge within 1 km of the path), used if the gauge rain is >= 1.0 mm per gauge link and the ratio is above 0, else g_e = 1 (S4.3, S8)",
 "offset_c": "c = the median of A over the dry minutes 120 to 30 min before the link's first wet bin (>= 30 such minutes, else 0); A = TL - baseline (baseline v2: the median dry TL of the 24 h before the event)",
