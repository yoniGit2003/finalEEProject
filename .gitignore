# Written by hand. Keep it short: add a line only for something that must never reach GitHub.

# ---- Data: raw, pipeline work files and the release (rebuilt with pipeline/get_data.py) ----
data/

# ---- Caches and logs of the research scripts (fit caches come from pipeline/get_caches.py) ----
.cache/
_cache/

# ---- Research outputs: everything in research/<module>/outputs/ is committed, except these big
#      files, which the scripts rebuild in a few minutes ----
research/wet_antenna/outputs/products/tails_1min.parquet
research/wet_antenna/outputs/products/tails_selected.csv
research/wet_antenna/outputs/tables/check_per_tail_fit_fits.parquet

# ---- The playground: local only, except its README ----
research/explorations/*
!research/explorations/README.md

# ---- Python ----
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# ---- PySR / Julia temporary output ----
hall_of_fame*.csv
hall_of_fame*.pkl

# ---- Editors and tools ----
.idea/
.vscode/
research/.vibe-wise/
.claude/settings.local.json

# ---- LaTeX build files (the PDF itself is committed) ----
*.aux
*.toc
*.out
*.synctex.gz

# ---- Safety net: raw-data formats and archives are never committed ----
*.nc
*.zip
*.zarr/

# ---- Old local folders (removed by the makeover; ignored in case a copy is still around) ----
_archive/
_review/
legacy/
